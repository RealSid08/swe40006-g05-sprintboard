{
  "name": "sprintboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite dev --host 127.0.0.1 --port 3417 --strictPort",
    "dev:convex": "convex dev --typecheck=disable",
    "build": "vite build",
    "start": "node server.mjs",
    "codegen": "convex codegen",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "release:manifest": "node scripts/release-manifest.mjs",
    "seed:account": "node scripts/seed-account.mjs",
    "test:cleanup": "node scripts/test-cleanup.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/react-query": "0.1.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "aws4fetch": "1.0.20",
    "better-auth": "1.6.33",
    "clsx": "2.1.1",
    "convex": "1.47.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "convex-test": "0.0.62",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
