FROM node:24.22.0-bookworm-slim AS node-runtime
FROM mcr.microsoft.com/playwright:v1.64.1-noble
COPY --from=node-runtime /usr/local /usr/local
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg && corepack enable pnpm && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app
RUN chown ubuntu:ubuntu /app
USER ubuntu
COPY --chown=ubuntu:ubuntu package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY --chown=ubuntu:ubuntu . .
CMD ["pnpm", "test:e2e"]
