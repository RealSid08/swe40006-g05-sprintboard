FROM node:24.22.0-bookworm-slim AS node-runtime
FROM mcr.microsoft.com/playwright:v1.64.1-noble
COPY --from=node-runtime /usr/local /usr/local
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg && corepack enable pnpm && corepack prepare pnpm@12.10.1 --activate
WORKDIR /app
RUN chown pwuser:pwuser /app
USER pwuser
COPY --chown=pwuser:pwuser package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY --chown=pwuser:pwuser . .
CMD ["pnpm", "test:e2e"]
